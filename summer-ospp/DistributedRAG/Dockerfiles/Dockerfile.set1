ARG BASE_IMAGE=hooyu/mindnlp-latest:1
FROM ${BASE_IMAGE}
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl ffmpeg fonts-noto-cjk libgl1 libglib2.0-0 libgomp1 \
    libreoffice-calc libreoffice-impress libreoffice-writer poppler-utils \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY . /app
ENTRYPOINT ["/app/Dockerfiles/entrypoint.sh"]
CMD ["streamlit", "run", "main_app1/main.py", "--server.port=7860", "--server.address=0.0.0.0"]
