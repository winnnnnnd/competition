POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=distributed_rag
STALE_JOB_SECONDS=900
CPU_BASE_IMAGE=hooyu/mindnlp-latest:1
ACCELERATED_BASE_IMAGE=hooyu/ms:latest
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=rag-documents

RAY_HEAD_CPUS=2
RAY_WORKER_CPUS=8
RAY_MAX_IN_FLIGHT=8
INGESTION_CONCURRENCY=2
OCR_ACTOR_COUNT=1
ASR_ACTOR_COUNT=1
EMBEDDING_ACTOR_COUNT=1
RERANKER_ACTOR_COUNT=1
OCR_FAILURE_MODE=fail
ASR_FAILURE_MODE=fail
ALLOW_CPU_MODEL_FALLBACK=true

CHUNK_SIZE=600
CHUNK_OVERLAP=120
EMBEDDING_BATCH_SIZE=32
MILVUS_WRITE_BATCH_SIZE=128
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_NLIST=1024
MILVUS_NPROBE=16
DENSE_TOP_N=30
RERANKER_TOP_N=20
FINAL_TOP_K=5

# Accelerated profile. For an NPU worker, set RAG_PROFILE=npu,
# RAY_MODEL_GPUS=0, RAY_MODEL_NPUS=0.25 and RAY_CUSTOM_RESOURCES={"NPU":1}.
GPU_COUNT=1
RAY_MODEL_GPUS=0.25
RAY_MODEL_NPUS=0
RAY_CUSTOM_RESOURCES=
NPU_VISIBLE_DEVICES=0
